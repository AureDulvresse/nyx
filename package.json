{
  "name": "nyx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "ts-node --project tsconfig.server.json server.ts",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "docker:build-kali": "docker build -t nyx/kali-tools:latest -f infra/kali-tools/Dockerfile infra/kali-tools",
    "docker:build-lab-web-api": "docker build -t nyx/lab-web-api-fragile:latest infra/labs/web-api-fragile",
    "docker:build-lab-ad": "docker build -t nyx/lab-ad-corp:latest infra/labs/ad-corp",
    "docker:build-lab-dfir": "docker build -t nyx/lab-dfir-workstation:latest infra/labs/dfir-workstation",
    "docker:build-lab-soc": "docker build -t nyx/lab-soc-siem:latest infra/labs/soc-siem",
    "docker:build-lab-osint": "docker build -t nyx/lab-osint-target:latest infra/labs/osint-target",
    "docker:build-labs": "npm run docker:build-lab-web-api && npm run docker:build-lab-ad && npm run docker:build-lab-dfir && npm run docker:build-lab-soc && npm run docker:build-lab-osint"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tailwindcss/typography": "^0.5.20",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "hugeicons-react": "^0.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "node-pty": "^1.1.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mermaidjs": "^7.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/dockerode": "^4.0.1",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
